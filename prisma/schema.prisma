generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  buyer
  seller
}

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  password        String
  name            String
  phone           String?
  avatar          String?
  role            Role            @default(buyer)
  isActive        Boolean         @default(true)
  refreshToken    String?
  resetOtp        String?
  resetOtpExpiry  DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  properties      Property[]
  bookmarks       Bookmark[]
  inquiriesSent   Inquiry[]       @relation("BuyerInquiries")

  @@map("users")
}

model Property {
  id           String          @id @default(uuid())
  slug         String          @unique
  title        String
  description  String          @db.Text
  features     String[]        @default([])
  price        Float
  propertyType String
  city         String
  location     String
  address      String?
  bedrooms     Int             @default(0)
  bathrooms    Int             @default(0)
  area         Float           @default(0)
  coverImage   String
  status       String          @default("active") // "active", "inactive", "sold"
  sellerId     String
  seller       User            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  images       PropertyImage[]
  bookmarks    Bookmark[]
  inquiries    Inquiry[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(uuid())
  url        String
  caption    String?
  sortOrder  Int      @default(0)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@map("property_images")
}

model Bookmark {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([propertyId])

  @@map("bookmarks")
}

model Inquiry {
  id           String    @id @default(uuid())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  senderId     String?
  sender       User?     @relation("BuyerInquiries", fields: [senderId], references: [id], onDelete: SetNull)
  name         String
  email        String
  phone        String?   @default("")
  message      String    @db.Text
  status       String    @default("new") // "new", "read", "replied"
  replyMessage String?   @db.Text
  repliedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([propertyId])
  @@index([senderId])
  @@index([status])
  @@map("inquiries")
}
